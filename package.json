{
  "name": "civiltrace",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~58.0.23",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-crypto": "~58.0.8",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-location": "~58.0.20",
    "expo-network": "~58.0.5",
    "expo-print": "~58.0.8",
    "expo-secure-store": "~58.0.2",
    "expo-sensors": "~58.0.4",
    "expo-sharing": "~58.0.22",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-qrcode-svg": "^6.3.54",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:cobertura": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "formatear": "prettier --write .",
    "verificar-formato": "prettier --check ."
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*-test.[jt]s?(x)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/simulados/**"
    ],
    "coverageThreshold": {
      "./src/servicios/local/**": {
        "lines": 60
      },
      "./src/servicios/servicio{Asistencia,Horario,DetallesAsistencia,Calendario}.ts": {
        "lines": 60
      },
      "./src/hooks/use{MiAsistencia,LecturaQr,HorarioObra,DetallesDia,Calendario,ObrasSupervisadas}.ts": {
        "lines": 60
      },
      "./src/componentes/{AvisoSincronizacion,CalendarioAsistencia,HojaDetalleDia,HojaDetallesAsistencia,SelectorHora,TarjetaHorarioDia,TarjetaTrabajador}.tsx": {
        "lines": 60
      },
      "./src/pantallas/supervisor/Pantalla{EscogerObra,LeerQr,ConfirmarQr,HorarioObra,CalendarioTrabajador,Rechazados}.tsx": {
        "lines": 60
      },
      "./src/pantallas/trabajador/Pantalla{MiAsistencia,HistorialAsistencia}.tsx": {
        "lines": 60
      },
      "./src/utilidades/formatoHoras.ts": {
        "lines": 60
      },
      "./src/conexion/clienteApi.ts": {
        "lines": 60
      },
      "./src/componentes/{SeccionCodigoTrabajadores,ProveedorLogoEmpresa,NavegacionInferior,EncabezadoApp,TarjetaCodigoAcceso}.tsx": {
        "lines": 60
      },
      "./src/hooks/use{TecladoVisible,LogoEmpresa}.ts": {
        "lines": 60
      },
      "./src/utilidades/validacionObra.ts": {
        "lines": 60
      }
    },
    "setupFilesAfterEnv": [
      "./jest.configuracionPruebas.ts"
    ],
    "maxWorkers": "50%"
  }
}
